---
// Base layout: one <head> (per-page title/description/canonical), shared fonts
// and global CSS, and the Nav + Footer chrome. Every page renders through this,
// so SEO metadata and chrome stay consistent and DRY (CLAUDE.md rule #6).
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// Fonts are self-hosted rather than fetched from Google's CDN. Two reasons: the
// privacy notice's processor list names Google for business email and the calendar
// link, not for serving fonts to every visitor, and embedding Google Fonts
// discloses each visitor's IP to Google (treated as a GDPR problem in EU case
// law). Self-hosting also removes a render-blocking cross-origin fetch.
// Only the weights actually used are imported: Raleway 400/700/800 (headings) and
// Lato 300/400/700 (body). The old CDN link declared eight, two of which
// (Raleway 300 and 600) nothing on the site ever used.
//
// Subsets are pinned rather than taking the default bundle, which ships Cyrillic,
// Greek and Vietnamese too. Raleway is latin only because it renders our own
// headings. Lato also takes latin-ext, because it is the body font and therefore
// the one that renders customer-typed names in the chat, which can carry accented
// characters outside plain latin.
import '@fontsource/raleway/latin-400.css';
import '@fontsource/raleway/latin-700.css';
import '@fontsource/raleway/latin-800.css';
import '@fontsource/lato/latin-300.css';
import '@fontsource/lato/latin-400.css';
import '@fontsource/lato/latin-700.css';
import '@fontsource/lato/latin-ext-300.css';
import '@fontsource/lato/latin-ext-400.css';
import '@fontsource/lato/latin-ext-700.css';
import '../styles/global.css';
// Trading day from the single source (D-006). The JSON-LD hours are the ones
// Google shows, so they must match the booking engine and the Business Profile.
import tradingHours from '../../../shared/config/tradingHours.js';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// Astro.site comes from astro.config.mjs; canonical is the absolute page URL.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = (Astro.site?.href ?? 'https://www.intelligentclean.co.uk/').replace(/\/$/, '');

// Site-wide LocalBusiness structured data. Only confirmed contact/geo facts —
// no cleaning-method or USP claims (those wait on the verified Texatherm brief).
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#business`,
  name: 'Intelligent Carpet Cleaning',
  description: 'Specialist carpet and upholstery cleaning serving Cheltenham and the wider Gloucestershire area.',
  url: siteUrl,
  image: `${siteUrl}/logo.jpg`,
  telephone: '+441242279590',
  email: 'hello@intelligentclean.co.uk',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cheltenham',
    addressRegion: 'Gloucestershire',
    addressCountry: 'GB',
  },
  areaServed: [
    'Cheltenham', 'Gloucester', 'Stroud', 'Tewkesbury', 'Cirencester',
    'Winchcombe', 'Bishops Cleeve', 'Charlton Kings', 'Prestbury', 'Gloucestershire',
  ],
  openingHoursSpecification: tradingHours.openingHoursSpecification(),
  priceRange: '££',
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/logo.jpg`} />
    <meta property="og:site_name" content="Intelligent Carpet Cleaning" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/logo.jpg`} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <!-- Optional per-page head content (e.g. care-guide FAQ/Article JSON-LD). -->
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
