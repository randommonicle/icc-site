---
// Base layout: one <head> (per-page title/description/canonical), shared fonts
// and global CSS, and the Nav + Footer chrome. Every page renders through this,
// so SEO metadata and chrome stay consistent and DRY (CLAUDE.md rule #6).
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// Fonts are self-hosted rather than fetched from Google's CDN. Two reasons: the
// privacy notice's processor list names Google for business email and the calendar
// link, not for serving fonts to every visitor, and embedding Google Fonts
// discloses each visitor's IP to Google (treated as a GDPR problem in EU case
// law). Self-hosting also removes a render-blocking cross-origin fetch.
// Only the weights actually used are imported: Raleway 400/700/800 (headings) and
// Lato 300/400/700 (body). The old CDN link declared eight, two of which
// (Raleway 300 and 600) nothing on the site ever used.
//
// Subsets are pinned rather than taking the default bundle, which ships Cyrillic,
// Greek and Vietnamese too. Raleway is latin only because it renders our own
// headings. Lato's latin-ext faces (customer-typed names in the chat can carry
// accented characters) are imported by book.astro alone, the one page that renders
// customer text, so the other 27 pages do not fetch 18 KB they never use (SEO audit
// T-10, 14 Sept 2026).
import '@fontsource/raleway/latin-400.css';
import '@fontsource/raleway/latin-700.css';
import '@fontsource/raleway/latin-800.css';
import '@fontsource/lato/latin-300.css';
import '@fontsource/lato/latin-400.css';
import '@fontsource/lato/latin-700.css';
import '../styles/global.css';
// Trading day from the single source (D-006). The JSON-LD hours are the ones
// Google shows, so they must match the booking engine and the Business Profile.
import tradingHours from '../../../shared/config/tradingHours.js';
// The served towns from the same config the surcharge logic reads (D-011), so
// the areaServed list below can never disagree with what the booking engine
// treats as core and wider.
import serviceArea from '../../../shared/config/serviceArea.js';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// Astro.site comes from astro.config.mjs; canonical is the absolute page URL.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = (Astro.site?.href ?? 'https://www.intelligentclean.co.uk/').replace(/\/$/, '');

// Site-wide LocalBusiness structured data. Only confirmed contact/geo facts —
// no cleaning-method or USP claims (those wait on the verified Texatherm brief).
// Shape follows the 14 Sept 2026 SEO audit's section 9 draft (S-05): `url` carries
// the trailing slash the home canonical uses, `logo` is set (Google's minimum is
// 112 px; logo.jpg is 900 x 491), `areaServed` is generated from the service-area
// config as typed places, and the base is Gloucester (D-044). No street address,
// postcode, geo or sameAs: the address is withheld by D-016 and no listing URL
// exists yet (add sameAs when the Business Profile is verified). aggregateRating
// stays absent until real reviews exist (D-015).
const villages = ["Bishop's Cleeve", 'Charlton Kings', 'Prestbury'];
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#business`,
  name: 'Intelligent Carpet Cleaning',
  slogan: 'Intelligence you can trust',
  description: 'Specialist carpet and upholstery cleaning based in Gloucester, serving Cheltenham and the whole of Gloucestershire.',
  url: `${siteUrl}/`,
  logo: `${siteUrl}/logo.jpg`,
  image: `${siteUrl}/logo.jpg`,
  telephone: '+441452452356',
  email: 'hello@intelligentclean.co.uk',
  founder: { '@type': 'Person', name: 'Mark McClymont' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Gloucester',
    addressRegion: 'Gloucestershire',
    addressCountry: 'GB',
  },
  areaServed: [
    ...serviceArea.core_towns.map((name: string) => ({ '@type': 'City', name })),
    ...serviceArea.wider_towns.map((name: string) => ({ '@type': 'City', name })),
    ...villages.map((name) => ({ '@type': 'Place', name })),
    { '@type': 'AdministrativeArea', name: 'Gloucestershire' },
  ],
  // Per-day hours (D-027): one OpeningHoursSpecification entry per open day, Sunday
  // absent. `closes` is a public-schedule modelling choice (the 1pm last start plus a
  // typical job length), not the soft operational close — see tradingHours.js.
  openingHoursSpecification: tradingHours.openingHoursSpecification(),
  priceRange: '££',
  currenciesAccepted: 'GBP',
  knowsAbout: [
    'Carpet cleaning',
    'Upholstery cleaning',
    'Stain treatment',
    'Ozone decontamination',
    'Disinfectant fogging',
    'Pressure washing',
  ],
};
---
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Square icons cropped from the logo's emblem by scripts/make-favicons.mjs.
         Google shows a result's favicon only when it is square and a multiple of
         48 px (icon-192); the old 900 x 491 logo.jpg was ignored and squashed the
         tab icon (SEO audit T-14). logo.jpg stays for Open Graph below. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/logo.jpg`} />
    <meta property="og:site_name" content="Intelligent Carpet Cleaning" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/logo.jpg`} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <!-- Optional per-page head content (e.g. care-guide FAQ/Article JSON-LD). -->
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
