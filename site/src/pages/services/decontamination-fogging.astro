---
// Decontamination & Fogging service page (D-038). Enquiry-led: these jobs are
// bespoke-quoted, so the page has no instant-quote path — the CTA is call/email.
// Claims discipline (D-015/L-009): Mark is CERTIFIED (not "accredited") in Infection
// Control and Bio-Hazard Fogging (Modular Training Solutions), cited in words, not the
// certificate image. Ozone is equipment/method, not a certified-ozone claim. No kill-rate
// or efficacy figures. Crime-scene work is scoped as decontamination, NOT forensic/trauma
// cleaning. Insurance covers the work (Ben, 9 Sep 2026). See D-038.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const siteUrl = (Astro.site?.href ?? 'https://www.intelligentclean.co.uk/').replace(/\/$/, '');
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Decontamination & Fogging',
  serviceType: 'Decontamination and fogging',
  provider: { '@type': 'LocalBusiness', '@id': `${siteUrl}/#business`, name: 'Intelligent Carpet Cleaning' },
  areaServed: 'Gloucestershire',
  description:
    'Professional ozone decontamination and disinfectant fogging for healthcare, end-of-tenancy, void and odour-affected properties across Cheltenham and Gloucestershire. Carried out by an operator certified in infection control and bio-hazard fogging.',
};


// Breadcrumb: Home › Services › this page (SEO audit S-02). Same three-item shape as
// the area and guide templates; top-level pages carry none.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteUrl}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Decontamination & Fogging', item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};

const useCases = [
  {
    icon: 'shield-check',
    title: 'Healthcare & infection control',
    body: 'Decontamination and fogging for clinical and care settings, including post-infection treatment of rooms after an outbreak or a patient stay.',
  },
  {
    icon: 'home',
    title: 'End-of-tenancy & void properties',
    body: 'Sanitising and odour treatment between tenancies and for empty properties, so a space is handed over fresh and ready to let.',
  },
  {
    icon: 'sparkles',
    title: 'Odour elimination',
    body: 'Ozone treatment tackles stubborn odours at source — smoke, damp, pets and general staleness — rather than masking them with fragrance.',
  },
  {
    icon: 'building',
    title: 'Specialist & crime-scene decontamination',
    body: 'Decontamination and odour treatment for affected spaces. This is a decontamination service; it does not include forensic or trauma scene cleaning.',
  },
];
---
<BaseLayout
  title="Ozone Decontamination & Fogging in Gloucestershire"
  description="Ozone decontamination and disinfectant fogging for healthcare, end-of-tenancy and odour-affected properties across Gloucestershire. Certified and insured."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  </Fragment>

  <section class="page-hero">
    <div class="page-hero-inner">
      <div class="section-label" style="color:var(--teal-light);">Specialist Services</div>
      <h1>Decontamination &amp; Fogging</h1>
      <p>Professional ozone decontamination and disinfectant fogging for healthcare, rental and void properties across Cheltenham and Gloucestershire. Carried out by an operator certified in infection control and bio-hazard fogging, and the work is insured.</p>
    </div>
  </section>

  <div class="svc-section">
    <div class="section-label">What We Do</div>
    <h2 class="section-title">Decontamination for the situations that need it</h2>
    <p class="section-sub">Every job is different, so each is quoted individually after we understand the property, the situation and the access. Below is the work we take on.</p>

    <div class="uc-grid">
      {useCases.map((u) => (
        <article class="uc-card">
          <div class="uc-icon"><Icon name={u.icon} color="#fff" /></div>
          <h3 class="uc-title">{u.title}</h3>
          <p class="uc-desc">{u.body}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="method-section">
    <div class="method-inner">
      <div class="method-text">
        <div class="section-label">Our Methods</div>
        <h2 class="section-title">Ozone and fogging</h2>
        <p><strong>Ozone treatment</strong> uses an ozone generator to break down odour and contamination in the air and on surfaces throughout a room. Because ozone is a respiratory irritant, treatment is always carried out in an unoccupied space; we ventilate the area afterwards and confirm it is safe to re-enter before handing it back.</p>
        <p><strong>Fogging</strong> disperses a fine disinfectant mist that settles across the surfaces of a room. It is well suited to post-infection decontamination in settings such as hospital and care rooms, where an even, whole-room treatment matters.</p>
      </div>
      <ul class="method-points">
        <li><strong>Certified operator.</strong> Mark is certified in Infection Control and Bio-Hazard Fogging (Advanced Specialist course, Modular Training Solutions).</li>
        <li><strong>Insured.</strong> The decontamination and fogging work is covered by our insurance.</li>
        <li><strong>Quoted per job.</strong> These jobs vary too much for a fixed price list, so we quote each one after understanding what is involved.</li>
        <li><strong>Across Gloucestershire.</strong> Cheltenham, Gloucester and the wider county, the same area we cover for carpet cleaning.</li>
      </ul>
    </div>
  </div>

  <div class="svc-cta">
    <h2>Need a decontamination or fogging quote?</h2>
    <p>Tell us the property, the situation and the access, and we will give you a price. There is no online instant quote for this work because every job is different.</p>
    <div class="cta-actions">
      <a class="btn-primary" href="tel:01452452356">Call 01452 452356</a>
      <a class="cta-secondary" href="mailto:hello@intelligentclean.co.uk">Email hello@intelligentclean.co.uk</a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--navy-dark), var(--navy));
    padding: 4rem 2rem;
    margin-top: 70px;
  }
  .page-hero-inner { max-width: 1100px; margin: 0 auto; }
  .page-hero h1 {
    font-family: "Raleway", sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: #fff;
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.02em;
  }
  .page-hero p {
    color: rgba(255, 255, 255, 0.65);
    font-size: 1rem;
    font-weight: 300;
    max-width: 680px;
    line-height: 1.7;
  }

  .svc-section { max-width: 1100px; margin: 0 auto; padding: 4rem 2rem 1rem; }
  .uc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .uc-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    border-top: 3px solid var(--teal);
    transition: box-shadow 0.2s;
  }
  .uc-card:hover { box-shadow: 0 8px 30px rgba(26, 138, 122, 0.12); }
  .uc-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--teal), var(--navy));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .uc-title {
    font-family: "Raleway", sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }
  .uc-desc { font-size: 0.9rem; color: var(--text-mid); line-height: 1.7; }

  .method-section { padding: 4rem 2rem; }
  .method-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .method-text p { font-size: 0.95rem; color: var(--text-mid); line-height: 1.75; margin-bottom: 1rem; }
  .method-text strong { color: var(--navy); }
  .method-points { list-style: none; display: flex; flex-direction: column; gap: 1rem; }
  .method-points li {
    background: var(--off-white);
    border-radius: 10px;
    border-left: 3px solid var(--teal);
    padding: 1.1rem 1.25rem;
    font-size: 0.9rem;
    color: var(--text-mid);
    line-height: 1.6;
  }
  .method-points strong { color: var(--navy); }

  .svc-cta {
    background: linear-gradient(135deg, var(--navy), var(--teal));
    padding: 4rem 2rem;
    text-align: center;
  }
  .svc-cta h2 {
    font-family: "Raleway", sans-serif;
    font-size: 1.8rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.6rem;
  }
  .svc-cta p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    font-weight: 300;
    max-width: 560px;
    margin: 0 auto 1.75rem;
    line-height: 1.7;
  }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; align-items: center; }
  .cta-actions .btn-primary { color: #fff; text-decoration: none; font-weight: 700; }
  .cta-secondary {
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 2px;
  }
  .cta-secondary:hover { border-bottom-color: #fff; }

  @media (max-width: 820px) {
    .page-hero h1 { font-size: 2rem; }
    .uc-grid { grid-template-columns: 1fr; }
    .method-inner { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
