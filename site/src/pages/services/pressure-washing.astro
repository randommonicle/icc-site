---
// Pressure Washing service page (D-038). Enquiry-led: bespoke-quoted, CTA is call/email.
// Claims discipline (D-015/L-009): biocide treatment stated as an available option, no
// named product and no kill-rate claim. Insurance covers the work (Ben, 9 Sep 2026).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const siteUrl = (Astro.site?.href ?? 'https://www.intelligentclean.co.uk/').replace(/\/$/, '');
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Pressure Washing',
  serviceType: 'Pressure washing',
  provider: { '@type': 'LocalBusiness', '@id': `${siteUrl}/#business`, name: 'Intelligent Carpet Cleaning' },
  areaServed: 'Gloucestershire',
  description:
    'External pressure washing for bin stores, patios, paving and external tiling across Cheltenham and Gloucestershire, with optional biocide treatment for algae and moss.',
};


// Breadcrumb: Home › Services › this page (SEO audit S-02). Same three-item shape as
// the area and guide templates; top-level pages carry none.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteUrl}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Pressure Washing', item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};

const useCases = [
  {
    icon: 'building',
    title: 'Bin stores & waste areas',
    body: 'Deep cleaning of communal and commercial bin stores and refuse areas, cutting back grime, residue and the smells that build up in them.',
  },
  {
    icon: 'home',
    title: 'Patios & paving',
    body: 'Restoring patios, paths and paved areas that have gone green and slippery with algae and ingrained dirt.',
  },
  {
    icon: 'droplets',
    title: 'External tiles & hard surfaces',
    body: 'External tiling, steps and other hard surfaces brought back to a clean, even finish.',
  },
  {
    icon: 'shield-check',
    title: 'Optional biocide treatment',
    body: 'A biocidal treatment can be applied after washing to tackle algae, moss and lingering growth and slow its return. Ask for it when you enquire.',
  },
];
---
<BaseLayout
  title="Pressure Washing in Cheltenham & Gloucestershire"
  description="Pressure washing for bin stores, patios, paving and external tiles across Gloucestershire, with optional biocide treatment for algae and moss. Insured."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  </Fragment>

  <section class="page-hero">
    <div class="page-hero-inner">
      <div class="section-label" style="color:var(--teal-light);">Specialist Services</div>
      <h1>Pressure Washing</h1>
      <p>External pressure washing across Cheltenham and Gloucestershire, from bin stores and paving to patios and external tiles, with optional biocide treatment for algae and moss. The work is insured.</p>
    </div>
  </section>

  <div class="svc-section">
    <div class="section-label">What We Do</div>
    <h2 class="section-title">Hard external surfaces, properly cleaned</h2>
    <p class="section-sub">Each job is quoted individually once we know the surface, the area and the access. Below is the work we take on.</p>

    <div class="uc-grid">
      {useCases.map((u) => (
        <article class="uc-card">
          <div class="uc-icon"><Icon name={u.icon} color="#fff" /></div>
          <h3 class="uc-title">{u.title}</h3>
          <p class="uc-desc">{u.body}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="svc-cta">
    <h2>Need a pressure washing quote?</h2>
    <p>Tell us the surface, the rough area and the access, and we will give you a price. Add biocide treatment to the enquiry if you want the algae and moss kept back for longer.</p>
    <div class="cta-actions">
      <a class="btn-primary" href="tel:01452452356">Call 01452 452356</a>
      <a class="cta-secondary" href="mailto:hello@intelligentclean.co.uk">Email hello@intelligentclean.co.uk</a>
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--navy-dark), var(--navy));
    padding: 4rem 2rem;
    margin-top: 70px;
  }
  .page-hero-inner { max-width: 1100px; margin: 0 auto; }
  .page-hero h1 {
    font-family: "Raleway", sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: #fff;
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.02em;
  }
  .page-hero p {
    color: rgba(255, 255, 255, 0.65);
    font-size: 1rem;
    font-weight: 300;
    max-width: 680px;
    line-height: 1.7;
  }

  .svc-section { max-width: 1100px; margin: 0 auto; padding: 4rem 2rem; }
  .uc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .uc-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    border-top: 3px solid var(--teal);
    transition: box-shadow 0.2s;
  }
  .uc-card:hover { box-shadow: 0 8px 30px rgba(26, 138, 122, 0.12); }
  .uc-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--teal), var(--navy));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .uc-title {
    font-family: "Raleway", sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }
  .uc-desc { font-size: 0.9rem; color: var(--text-mid); line-height: 1.7; }

  .svc-cta {
    background: linear-gradient(135deg, var(--navy), var(--teal));
    padding: 4rem 2rem;
    text-align: center;
  }
  .svc-cta h2 {
    font-family: "Raleway", sans-serif;
    font-size: 1.8rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.6rem;
  }
  .svc-cta p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    font-weight: 300;
    max-width: 560px;
    margin: 0 auto 1.75rem;
    line-height: 1.7;
  }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; align-items: center; }
  .cta-actions .btn-primary { color: #fff; text-decoration: none; font-weight: 700; }
  .cta-secondary {
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 2px;
  }
  .cta-secondary:hover { border-bottom-color: #fff; }

  @media (max-width: 820px) {
    .page-hero h1 { font-size: 2rem; }
    .uc-grid { grid-template-columns: 1fr; }
  }
</style>
