---
// Booking page = the AI assistant. The Phase 0 #chat-section ported faithfully:
// same markup, same DOM-based (injection-safe) rendering, same /api/chat and
// /api/chat?action=confirm_booking contract — only the SPA section-toggle
// (showSection) and the unused showToast are dropped.
//
// The chat CSS is `is:global` because the message bubbles, typing indicator,
// and confirmation block are created at runtime by JS — Astro's default scoped
// styles attach a build-time hash that runtime-created elements never get, so
// scoping would leave them unstyled. This <style> is still only bundled into
// /book, so the global selectors don't leak to other pages.
//
// The script is `is:inline` so its functions stay on the global scope for the
// existing inline on* handlers in the markup (Astro's default module <script>
// would scope them and break the handlers).
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout
  title="Book a Carpet Clean | Intelligent Carpet Cleaning"
  description="Describe your carpet to ICC's AI assistant, get an itemised quote with the reasoning behind it, and book a slot. Cheltenham, Gloucester and Gloucestershire."
>
  <div class="chat-page">
    <div class="chat-page-header">
      <h1>Get your quote and book your clean</h1>
      <p>Describe your carpet and the assistant will suggest a method, price the job line by line, and book you in, with the method confirmed on the day. It's an AI working from ICC's own carpet care reference, and it hands over to Mark when a question needs a person.</p>
    </div>
    <div class="chat-container-outer">
      <div class="chat-window">
        <div class="chat-window-header">
          <div style="width:40px;height:40px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;border:2px solid rgba(255,255,255,0.3);flex-shrink:0;"><Icon name="sparkles" size={20} color="#fff" /></div>
          <div class="chat-window-info">
            <div class="chat-window-name">ICC booking assistant</div>
            <div class="chat-window-status">AI assistant for Intelligent Carpet Cleaning</div>
          </div>
        </div>
        <!-- role="log" + aria-live so a screen reader announces the assistant's
             replies as they arrive; without it the conversation is silent to
             anyone not watching the screen. -->
        <div class="chat-messages" id="chatMessages" role="log" aria-live="polite" aria-atomic="false" aria-label="Conversation with the carpet cleaning assistant">
          <div class="msg-row">
            <div class="msg-avatar"><img src="/logo.jpg" alt="ICC" /></div>
            <div>
              <div class="msg-bubble bot" id="welcomeBubble">Hi, welcome to Intelligent Carpet Cleaning. I'm the booking assistant, an AI, and I can quote for your carpets, advise on stains and cleaning methods, and book you in.<br><br>To start, tell me which rooms you'd like cleaned and roughly how big they are, plus anything you're concerned about such as stains or heavy soiling. You can also add a photo with the camera icon.</div>
              <div class="msg-time">Now</div>
            </div>
          </div>
        </div>
        <div class="quick-suggestions" id="quickSuggestions">
          <button type="button" class="suggestion-chip" onclick="sendSuggestion('I\'d like a quote for my carpets.')">Get a quote</button>
          <button type="button" class="suggestion-chip" onclick="sendSuggestion('Can you help me work out what type of carpet I have?')">What carpet do I have?</button>
          <button type="button" class="suggestion-chip" onclick="sendSuggestion('Is professional cleaning better than hiring a machine myself?')">DIY vs professional</button>
          <button type="button" class="suggestion-chip" onclick="sendSuggestion('Can you help with a stain on my carpet?')">Stain advice</button>
        </div>
        <div class="chat-input-area">
          <label for="imageUpload" style="width:38px;height:38px;background:rgba(26,138,122,0.15);border:1px solid rgba(26,138,122,0.3);border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;font-size:16px;transition:background 0.2s;" title="Upload a photo of your carpet"><Icon name="camera" size={18} color="var(--teal)" /></label>
          <input type="file" id="imageUpload" accept="image/*" aria-label="Upload a photo of your carpet" style="position:absolute;width:1px;height:1px;padding:0;margin:0;overflow:hidden;clip:rect(0,0,0,0);border:0;" onchange="handleImageUpload(event)" />
          <textarea class="chat-input" id="chatInput" aria-label="Type your message to the carpet cleaning assistant" placeholder="Ask about a quote, your carpet or a stain, or add a photo with the camera icon" rows="1" onkeydown="handleKeyDown(event)" oninput="autoResize(this);onInputActivity();"></textarea>
          <button class="chat-send-btn" id="sendBtn" aria-label="Send message" onclick="sendMessage()"><Icon name="send" size={18} /></button>
        </div>
        <div id="imagePreviewArea" style="display:none;padding:0.5rem 1.25rem;background:#fff;border-top:1px solid var(--border);">
          <div style="display:flex;align-items:center;gap:8px;background:rgba(26,138,122,0.08);border:1px solid rgba(26,138,122,0.2);border-radius:8px;padding:8px 12px;">
            <img id="imagePreviewThumb" style="width:48px;height:48px;object-fit:cover;border-radius:6px;" src="" alt="" />
            <div style="flex:1;font-size:0.8rem;color:var(--text-mid);" id="imagePreviewName">Photo ready to send</div>
            <button onclick="clearImage()" aria-label="Remove photo" style="background:none;border:none;cursor:pointer;color:var(--text-light);font-size:1rem;"><Icon name="x" size={16} /></button>
          </div>
        </div>
      </div>
      <p class="chat-fallback">Prefer to talk to a person? Call <a href="tel:01452452356">01452 452356</a> or email <a href="mailto:hello@intelligentclean.co.uk">hello@intelligentclean.co.uk</a>. Our <a href="/terms/">booking terms</a> cover the deposit and cancellation, and our <a href="/privacy/">privacy notice</a> explains how we handle your details.</p>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .chat-page{padding-top:70px;min-height:100vh;background:linear-gradient(180deg,var(--off-white) 0%,#fff 100%);}
  .chat-page-header{background:linear-gradient(135deg,var(--navy-dark) 0%,var(--navy) 100%);padding:2.5rem 2rem;display:flex;flex-direction:column;align-items:center;gap:0.5rem;}
  .chat-page-header img{height:65px;width:auto;margin-bottom:0.5rem;object-fit:contain;}
  .chat-page-header h1{font-family:"Raleway",sans-serif;font-size:1.8rem;font-weight:800;color:#fff;}
  .chat-page-header p{color:rgba(255,255,255,0.65);font-size:0.95rem;font-weight:300;text-align:center;}
  .chat-container-outer{max-width:800px;margin:0 auto;padding:2rem;}
  .chat-window{background:#fff;border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:0 4px 40px rgba(12,44,37,0.12);}
  .chat-window-header{background:linear-gradient(135deg,var(--navy),var(--teal));padding:0.85rem 1.5rem;display:flex;align-items:center;gap:14px;}
  .chat-window-info{flex:1;}
  .chat-window-name{font-family:"Raleway",sans-serif;font-size:0.95rem;font-weight:700;color:#fff;}
  .chat-window-status{font-size:0.72rem;color:rgba(255,255,255,0.7);}
  .chat-messages{height:480px;overflow-y:auto;padding:1.5rem;display:flex;flex-direction:column;gap:1rem;background:var(--chat-bg);}
  .chat-messages::-webkit-scrollbar{width:4px;}
  .chat-messages::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}
  .msg-row{display:flex;gap:10px;animation:fadeIn 0.3s ease;}
  .msg-row.user{flex-direction:row-reverse;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .msg-avatar{width:34px;height:34px;flex-shrink:0;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-top:2px;overflow:hidden;background:linear-gradient(135deg,var(--teal),var(--navy));}
  .msg-avatar img{width:100%;height:100%;object-fit:cover;}
  .msg-avatar.user{background:var(--navy);font-size:11px;font-weight:700;color:#fff;font-family:"Raleway",sans-serif;}
  .msg-bubble{max-width:72%;padding:0.75rem 1rem;border-radius:14px;font-size:0.9rem;line-height:1.6;}
  .msg-bubble.bot{background:#fff;color:var(--text-dark);border:1px solid var(--border);border-bottom-left-radius:4px;}
  .msg-bubble.user{background:var(--navy);color:#fff;border-bottom-right-radius:4px;}
  .msg-time{font-size:0.68rem;color:var(--text-light);margin-top:4px;padding:0 4px;}
  .msg-row.user .msg-time{text-align:right;}
  .typing-indicator{display:flex;gap:5px;align-items:center;padding:0.75rem 1rem;}
  .typing-dot{width:7px;height:7px;background:var(--teal);border-radius:50%;animation:typingBounce 1.2s infinite;}
  .typing-dot:nth-child(2){animation-delay:0.2s;}
  .typing-dot:nth-child(3){animation-delay:0.4s;}
  @keyframes typingBounce{0%,60%,100%{transform:translateY(0);opacity:0.5}30%{transform:translateY(-6px);opacity:1}}
  .chat-input-area{padding:1rem 1.25rem;background:#fff;border-top:1px solid var(--border);display:flex;gap:10px;align-items:flex-end;}
  .chat-input{flex:1;border:1px solid var(--border);border-radius:10px;padding:0.75rem 1rem;font-family:"Lato",sans-serif;font-size:0.9rem;color:var(--text-dark);resize:none;outline:none;transition:border-color 0.2s;max-height:120px;min-height:44px;line-height:1.5;}
  .chat-input:focus{border-color:var(--teal);}
  .chat-send-btn{width:44px;height:44px;background:var(--teal);border:none;border-radius:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background 0.2s,transform 0.15s;font-size:16px;color:#fff;}
  .chat-send-btn:hover{background:var(--green-mid);transform:scale(1.05);}
  .chat-send-btn:disabled{background:var(--border);cursor:not-allowed;transform:none;}
  .quick-suggestions{padding:0.75rem 1.25rem;background:#fff;border-top:1px solid var(--border);display:flex;gap:0.5rem;flex-wrap:wrap;}
  .suggestion-chip{background:rgba(26,138,122,0.08);border:1px solid rgba(26,138,122,0.25);border-radius:100px;padding:0.35rem 0.9rem;font-size:0.78rem;color:var(--teal);cursor:pointer;transition:background 0.2s;font-family:"Lato",sans-serif;}
  .suggestion-chip:hover{background:rgba(26,138,122,0.15);}
  .chat-fallback{max-width:800px;margin:0 auto;padding:0 2rem 2.5rem;text-align:center;font-size:0.82rem;color:var(--text-light);line-height:1.6;}
  .chat-fallback a{color:var(--teal);text-decoration:none;font-weight:700;}
  .chat-fallback a:hover{text-decoration:underline;}

  /* The chat is the conversion surface, so on a phone the text box has to be on
     screen when the page loads. At 375x812 it sat ~167px below the fold: the page
     header ate 190px before the chat even started, then a fixed 480px message list
     pushed the suggestions strip and input off-screen. Two changes rather than one,
     because shrinking only the conversation would have made it uselessly short:
     tighten the header chrome, then size the message list against the viewport.
     The 450px subtrahend is the chat furniture below the list (suggestions 89 +
     input area 83) plus everything above it, with a few pixels of margin;
     measured at 375x812, not guessed. dvh first for browsers that have it, vh as
     the fallback, and a min-height so a very short screen degrades to a scroll
     rather than a sliver.
     The 16px input size is deliberate: iOS Safari auto-zooms the whole page when a
     focused input is under 16px, and 0.9rem computes to 14.4px. */
  @media (max-width: 768px){
    .chat-page-header{padding:1.5rem 1.25rem;}
    .chat-page-header h1{font-size:1.4rem;}
    .chat-page-header p{font-size:0.85rem;}
    .chat-messages{height:auto;min-height:220px;max-height:calc(100vh - 450px);max-height:calc(100dvh - 450px);}
    .chat-input{font-size:16px;}
  }
</style>

<script is:inline>
const LOGO="/logo.jpg";
let conversationHistory=[];
// Render the welcome bubble. Built via DOM nodes so the copy can never inject HTML.
(function(){
  const wb = document.getElementById("welcomeBubble");
  if(!wb) return;
  while(wb.firstChild) wb.removeChild(wb.firstChild);
  wb.appendChild(document.createTextNode("Hi, welcome to Intelligent Carpet Cleaning. I'm the booking assistant, an AI, and I can quote for your carpets, advise on stains and cleaning methods, and book you in."));
  wb.appendChild(document.createElement("br"));
  wb.appendChild(document.createElement("br"));
  wb.appendChild(document.createTextNode("To start, tell me which rooms you'd like cleaned and roughly how big they are, plus anything you're concerned about such as stains or heavy soiling. You can also add a photo with the camera icon."));
})();

// Inactivity timer - 3 minutes between checks, max 3 reminders then session ends
let inactivityTimer=null;
let inactivityCount=0;
let conversationClosed=false;
const INACTIVITY_MS=3*60*1000;

function scheduleInactivityCheck(){
  if(inactivityTimer) clearTimeout(inactivityTimer);
  inactivityTimer=setTimeout(handleInactivity,INACTIVITY_MS);
}

function cancelInactivityTimer(){
  if(inactivityTimer) clearTimeout(inactivityTimer);
  inactivityTimer=null;
}

function resetInactivityTimer(){
  inactivityCount=0;
  scheduleInactivityCheck();
}

// Close the conversation when the customer has said goodbye (the model emits a
// CONVERSATION_END marker, stripped before display). Cancels the inactivity timer
// so we never nag "still there?" after they're done, and ends the session the same
// way the final inactivity reminder does. Refreshing the page starts a fresh
// conversation.
function endConversation(){
  conversationClosed=true;
  cancelInactivityTimer();
  const input=document.getElementById("chatInput");
  const btn=document.getElementById("sendBtn");
  if(input){ input.disabled=true; input.placeholder="This chat has ended. Refresh the page to start a new one."; }
  if(btn) btn.disabled=true;
}

function handleInactivity(){
  inactivityCount++;
  if(inactivityCount===1){
    appendMessage("bot","Still there? No rush. I'm here whenever you're ready.");
    scheduleInactivityCheck();
  } else if(inactivityCount===2){
    appendMessage("bot","Just checking in again. If now isn't a good moment, that's fine. This chat stays open while the page is open, and you can start a fresh one whenever you like.");
    scheduleInactivityCheck();
  } else {
    appendMessage("bot","I'll leave you to it for now. Come back any time for a quote or to book, or call us on 01452 452356 or email hello@intelligentclean.co.uk. Bye for now.");
    // S3 (copy review, 14 Sept 2026): stop reminding, but do NOT lock the box. A customer
    // who went to measure a room or find a photo came back to a dead chat and a refresh
    // that started from nothing. Only a real goodbye disables the input (endConversation).
    cancelInactivityTimer();
  }
}

function autoResize(el){el.style.height="auto";el.style.height=Math.min(el.scrollHeight,120)+"px";}
// Reset the inactivity timer while the user is typing, but only once the
// conversation is underway — otherwise we'd start a timer before they've
// even sent their first message.
function onInputActivity(){ if(conversationHistory.length>0) resetInactivityTimer(); }
function handleKeyDown(e){if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();sendMessage();}}
function sendSuggestion(t){document.getElementById("chatInput").value=t;document.getElementById("quickSuggestions").style.display="none";sendMessage();}
function getTime(){return new Date().toLocaleTimeString("en-GB",{hour:"2-digit",minute:"2-digit"});}

function appendMessage(role,text,citations){
  const c=document.getElementById("chatMessages");
  const row=document.createElement("div");row.className="msg-row "+role;
  const av=document.createElement("div");av.className="msg-avatar"+(role==="user"?" user":"");
  if(role==="bot"){const img=document.createElement("img");img.src=LOGO;img.alt="ICC";av.appendChild(img);}
  else{av.textContent="You";}
  const wrap=document.createElement("div");
  const bub=document.createElement("div");bub.className="msg-bubble "+role;
  // Build paragraphs via DOM nodes (textContent) instead of innerHTML so any
  // markup in the AI response (or a prompt-injected reply) is rendered as text
  // and never executed.
  const paras=String(text==null?"":text).split(/\n{2,}/);
  paras.forEach(function(p,i){
    const pEl=document.createElement("p");
    pEl.style.margin = (i===paras.length-1) ? "0" : "0 0 0.55em 0";
    const lines=p.split("\n");
    lines.forEach(function(line,li){
      pEl.appendChild(document.createTextNode(line));
      if(li<lines.length-1) pEl.appendChild(document.createElement("br"));
    });
    bub.appendChild(pEl);
  });
  if(role==="bot") renderCitations(bub,citations);
  const t=document.createElement("div");t.className="msg-time";t.textContent=getTime();
  wrap.appendChild(bub);wrap.appendChild(t);row.appendChild(av);row.appendChild(wrap);c.appendChild(row);
  c.scrollTop=c.scrollHeight;
}

// Maps a knowledge-base section id (shared/config/knowledge.js) to the care guide
// that covers the same ground. Only sections a guide genuinely covers appear here:
// an entry with no guide stays an inert caption rather than becoming a link that
// lands the customer somewhere that does not answer the question. Keep in step with
// site/src/content/guides/ — a slug here that has no matching guide is a 404.
const KB_GUIDE_SLUGS={
  texatherm_system:"low-moisture-vs-hot-water-extraction",
  carpet_type_and_method:"natural-fibre-carpets",
  stain_guidance:"which-carpet-stains-are-permanent",
  time_estimates:"carpet-drying-and-aftercare",
  diy_vs_professional:"diy-vs-professional-carpet-cleaning"
};

// Render the sources an answer was grounded in (Slice 4c/4d, D-019) as a small,
// muted provenance caption. Everything is built from DOM nodes (never innerHTML),
// so it stays L-003-safe. Two lanes:
//   - KB sections (no url): the section title, linked to its care guide where one
//     exists (KB_GUIDE_SLUGS above) and inert text where it does not. The guides
//     went live at the Phase 1 cutover, which is what the original
//     TODO(citation-links) was waiting on.
//   - Web sources (Slice 4d, entries with a url): attributed external links, per
//     D-019. The href is only set after an http(s) check (the server filters too,
//     belt and braces), built with createElement + setAttribute, opened in a new
//     tab with rel="noopener noreferrer".
function renderCitations(bub,citations){
  if(!Array.isArray(citations)||!citations.length) return;
  const isWeb=function(cit){return cit&&typeof cit.url==="string"&&/^https?:\/\//i.test(cit.url);};
  // Three-way split: KB entries carry no url at all; web entries carry a SAFE
  // http(s) url; anything with an unsafe url is dropped outright, never demoted
  // to a trusted-looking KB label (defence in depth with the server filter).
  const kb=citations.filter(function(cit){return cit&&cit.url==null;});
  const web=citations.filter(isWeb);
  const box=document.createElement("div");
  box.style.cssText="margin-top:0.6em;padding-top:0.45em;border-top:1px solid rgba(0,0,0,0.08);font-size:0.75em;line-height:1.4;opacity:0.62;";
  if(kb.length){
    const kbLine=document.createElement("div");
    kbLine.appendChild(document.createTextNode("From ICC's carpet care reference: "));
    kb.forEach(function(cit,i){
      if(i>0) kbLine.appendChild(document.createTextNode(", "));
      const title=String(cit&&cit.title?cit.title:"reference");
      const slug=cit&&cit.id?KB_GUIDE_SLUGS[cit.id]:null;
      if(slug){
        const a=document.createElement("a");
        a.textContent=title;
        // Slug comes from our own constant, never from the model, so the path is
        // built from a known-safe value rather than anything the reply supplied.
        a.setAttribute("href","/guides/"+slug+"/");
        a.style.cssText="color:inherit;text-decoration:underline;";
        kbLine.appendChild(a);
      } else {
        kbLine.appendChild(document.createTextNode(title));
      }
    });
    kbLine.appendChild(document.createTextNode("."));
    box.appendChild(kbLine);
  }
  if(web.length){
    const webLine=document.createElement("div");
    webLine.appendChild(document.createTextNode("Looked up on the web: "));
    web.forEach(function(cit,i){
      if(i>0) webLine.appendChild(document.createTextNode(", "));
      const a=document.createElement("a");
      a.textContent=String(cit.title||"source");
      a.setAttribute("href",cit.url);
      a.setAttribute("target","_blank");
      a.setAttribute("rel","noopener noreferrer");
      a.style.cssText="color:inherit;text-decoration:underline;";
      webLine.appendChild(a);
    });
    webLine.appendChild(document.createTextNode("."));
    box.appendChild(webLine);
  }
  if(!box.childNodes.length) return;
  bub.appendChild(box);
}

function showTyping(){
  const c=document.getElementById("chatMessages");
  const row=document.createElement("div");row.className="msg-row";row.id="typingRow";
  const av=document.createElement("div");av.className="msg-avatar";
  const img=document.createElement("img");img.src=LOGO;img.alt="ICC";av.appendChild(img);
  const bub=document.createElement("div");bub.className="msg-bubble bot";
  bub.innerHTML='<div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div>';
  row.appendChild(av);row.appendChild(bub);c.appendChild(row);c.scrollTop=c.scrollHeight;
}

function removeTyping(){const t=document.getElementById("typingRow");if(t)t.remove();}

let pendingImage = null; // {base64: string, mediaType: string, name: string}

function handleImageUpload(event){
  const file = event.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    const dataUrl = e.target.result;
    const base64 = dataUrl.split(",")[1];
    const mediaType = file.type || "image/jpeg";
    pendingImage = {base64, mediaType, name: file.name};
    document.getElementById("imagePreviewThumb").src = dataUrl;
    document.getElementById("imagePreviewName").textContent = file.name + ", ready to send";
    document.getElementById("imagePreviewArea").style.display = "block";
  };
  reader.readAsDataURL(file);
}

function clearImage(){
  pendingImage = null;
  document.getElementById("imageUpload").value = "";
  document.getElementById("imagePreviewArea").style.display = "none";
}

function appendImageMessage(src, name){
  const container = document.getElementById("chatMessages");
  const row = document.createElement("div");
  row.className = "msg-row user";
  const av = document.createElement("div");
  av.className = "msg-avatar user";
  av.textContent = "You";
  const wrap = document.createElement("div");
  const bub = document.createElement("div");
  bub.className = "msg-bubble user";
  bub.style.cssText = "padding:6px;";
  const img = document.createElement("img");
  img.src = src;
  img.style.cssText = "max-width:200px;max-height:150px;border-radius:8px;display:block;";
  const cap = document.createElement("div");
  cap.style.cssText = "font-size:0.75rem;opacity:0.7;margin-top:4px;";
  cap.textContent = name;
  bub.appendChild(img);
  bub.appendChild(cap);
  const t = document.createElement("div");
  t.className = "msg-time";
  t.textContent = getTime();
  wrap.appendChild(bub);
  wrap.appendChild(t);
  row.appendChild(av);
  row.appendChild(wrap);
  container.appendChild(row);
  container.scrollTop = container.scrollHeight;
}

/* __BOOKING_READY_EXTRACTOR__ */
// Extract the JSON object after a BOOKING_READY: marker, tolerating the nested
// quote_lines array (D-004) and any prose the model adds after the payload. It is a
// brace-depth scan that ignores braces inside strings, and returns the parsed booking
// or null when the marker is absent or the payload will not parse. The previous
// non-greedy capture /BOOKING_READY: followed by (\{[\s\S]*?\}) stopped at the first
// inner brace and silently dropped every structured-pricing booking
// (test/booking-ready-parse.test.js).
function extractBookingReady(text){
  // Require the object's opening brace immediately after the marker (whitespace
  // tolerated) — the format the model always emits. This stops a stray or empty brace
  // between the marker and the payload (e.g. "BOOKING_READY: {} {...}") being taken as
  // the payload, and stops a bare prose mention of the token registering as an attempt.
  const m=/BOOKING_READY:\s*\{/.exec(text);
  if(!m) return null;
  const start=text.indexOf("{",m.index);
  let depth=0,inStr=false,esc=false;
  for(let i=start;i<text.length;i++){
    const ch=text[i];
    if(esc){esc=false;continue;}
    if(ch==="\\"){esc=true;continue;}
    if(ch==='"'){inStr=!inStr;continue;}
    if(inStr) continue;
    if(ch==="{"){depth++;}
    else if(ch==="}"){
      depth--;
      if(depth===0){
        try{
          const obj=JSON.parse(text.slice(start,i+1));
          return (obj && typeof obj==="object" && !Array.isArray(obj) && Object.keys(obj).length) ? obj : null;
        }catch(e){ return null; }
      }
    }
  }
  return null;
}
/* __END_BOOKING_READY_EXTRACTOR__ */

/* __BOOKING_REFUSAL__ */
// Decide from the confirm_booking response whether the booking was REFUSED and, if so,
// what to tell the customer. A body with success:true IS a booking, whatever else it
// carries: the row is persisted and the slot held before any email is attempted, and
// emailStatus says which emails went (the card copy below reads it). Only a body
// WITHOUT success:true is a refusal, and those carry error alone. Testing error first
// announced a saved booking as a failure when the email send threw (L-041).
// The wording follows the HTTP status (copy review E2, 14 Sept 2026): the server's own
// customer-facing sentences (409 slot taken, 429 too many requests, 502/503 the store
// write failed) already say what to do, so they are shown as written and nothing is
// appended; a 400 is a rejected detail, so the customer is asked for the correct one;
// anything else gets the call-us line with the server's text in brackets for
// diagnosis. Extract-and-run tested and kept byte-identical in book.astro and
// index.html (test/booking-outcome.test.js).
function bookingRefusal(bookData, status){
  var d = (bookData && typeof bookData === "object") ? bookData : {};
  if(d.success === true) return null;
  var reason = (typeof d.error === "string") ? d.error.trim().replace(/[.\s]+$/, "") : "";
  var code = Number(status);
  if(reason && (code === 409 || code === 429 || code === 502 || code === 503)) return reason + ".";
  if(reason && code === 400) return "Sorry, I couldn't complete the booking: " + reason + ". Tell me the correct details and I'll try again, or call 01452 452356.";
  return "Sorry, I couldn't complete your booking just now" + (reason ? " (" + reason + ")" : "") + ". Please call 01452 452356 or email hello@intelligentclean.co.uk and we'll book it for you.";
}
/* __END_BOOKING_REFUSAL__ */

async function processBooking(booking){
  try{
    const availRes = await fetch("/api/chat",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({action:"check_availability",date:booking.date,slots_needed:booking.slots_needed})
    });
    const availData = await availRes.json();
    const startHour = parseInt(booking.start_time.split(":")[0]);
    const requestedSlots = Array.from({length:booking.slots_needed},function(_,i){return startHour+i;});
    const isAvailable = !requestedSlots.some(function(s){return availData.booked&&availData.booked.includes(s);});

    if(!isAvailable){
      const parts=booking.date.split("-");const readableDate=new Date(parts[0],parts[1]-1,parts[2]).toLocaleDateString("en-GB",{weekday:"long",day:"numeric",month:"long",year:"numeric"});const remaining=(availData.available||[]).map(String);
      // E1: a full day gets a different sentence, not "are: ." (copy review, 14 Sept 2026).
      appendMessage("bot", remaining.length
        ? "Sorry, that time has just been taken. On "+readableDate+" you could still start at "+(remaining.length>1 ? remaining.slice(0,-1).join(", ")+" or "+remaining[remaining.length-1] : remaining[0])+". Which would you prefer?"
        : "Sorry, that time has just been taken and nothing else is free on "+readableDate+". Tell me another date and I'll check it.");
      return;
    }

    const bookRes = await fetch("/api/chat",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({action:"confirm_booking",booking:Object.assign({},booking,{image:window.lastUploadedImage||null})})
    });
    const bookData = await bookRes.json();

    const refusal = bookingRefusal(bookData, bookRes.status);
    if(refusal){
      appendMessage("bot",refusal);
      return;
    }

    const msgs = document.getElementById("chatMessages");
    const confirmDiv = document.createElement("div");
    confirmDiv.className = "msg-row";
    const av = document.createElement("div");
    av.className = "msg-avatar bot";
    av.textContent = "✓"; // unslop-ignore: functional sent-status tick, not decorative emoji
    av.style.cssText = "background:linear-gradient(135deg,#1a8a7a,#0c2c25);font-size:16px;color:#fff;";
    const wrap = document.createElement("div");
    const bub = document.createElement("div");
    bub.className = "msg-bubble bot";
    bub.style.cssText = "border-left:3px solid #1a8a7a;";
    // Build the confirmation block via DOM nodes so booking fields are text-only.
    function strong(txt){ const s=document.createElement("strong"); s.textContent=String(txt||""); return s; }
    // D2: the customer sees "Friday 25 September 2026", not the payload's ISO date.
    // Formatted by hand, the same way chat.js formats the email, so screen and email agree.
    const readableDate = (function(){ const p=String(booking.date||"").split("-").map(Number); if(p.length!==3||p.some(isNaN)) return booking.date; const d=new Date(p[0],p[1]-1,p[2]); if(isNaN(d.getTime())) return booking.date; return ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"][d.getDay()]+" "+d.getDate()+" "+["January","February","March","April","May","June","July","August","September","October","November","December"][d.getMonth()]+" "+d.getFullYear(); })();
    const isProvisional = bookData.provisional === true;
    // The server reports which emails actually sent (emailStatus.{operator,customer}).
    // Only make a claim we can stand behind: if EITHER the customer's email or Mark's
    // operator email failed, fall back to an honest "we'll be in touch / call us" line
    // rather than promising it all went out. The operator half is what strands a
    // provisional slot, so it must gate "Mark will confirm" too (L-029).
    const emailStatus = bookData.emailStatus || {};
    const customerEmailFailed = emailStatus.customer === false;
    const operatorEmailFailed = emailStatus.operator === false;
    const anyEmailFailed = customerEmailFailed || operatorEmailFailed;
    const title = document.createElement("strong");
    title.style.color = "#1a8a7a";
    title.textContent = isProvisional ? "Booking received" : "Booking confirmed";
    bub.appendChild(title);
    bub.appendChild(document.createElement("br"));
    if(isProvisional){
      // D-027: a late-finish booking is HELD, not confirmed — Mark confirms the time.
      bub.appendChild(document.createTextNode("We've provisionally held "));
      bub.appendChild(strong(readableDate));
      bub.appendChild(document.createTextNode(" at "));
      bub.appendChild(strong(booking.start_time));
      bub.appendChild(document.createTextNode(anyEmailFailed
        ? " for you. As this clean would finish later in the afternoon, it needs confirming before it's final. We'll be in touch shortly to confirm the time and arrange your deposit; if you don't hear from us soon, please call us on 01452 452356."
        : " for you. As this clean would finish later in the afternoon, Mark will confirm the time with you personally and arrange your deposit. We've emailed you a summary."));
    } else {
      bub.appendChild(document.createTextNode("Your appointment is booked for "));
      bub.appendChild(strong(readableDate));
      bub.appendChild(document.createTextNode(" at "));
      bub.appendChild(strong(booking.start_time));
      bub.appendChild(document.createTextNode("."));
      bub.appendChild(document.createElement("br"));
      bub.appendChild(document.createElement("br"));
      if(anyEmailFailed){
        bub.appendChild(document.createTextNode("Your booking is saved, but we couldn't send all of the confirmation emails. Please call 01452 452356 to confirm it with us."));
      } else {
        bub.appendChild(document.createTextNode("We've emailed a confirmation to "));
        bub.appendChild(strong(booking.email));
        bub.appendChild(document.createTextNode(" and let Mark know. If you can't see it, check your junk folder."));
      }
    }
    // Deposit pay link (D-004): the server threads depositPayUrl into the response only
    // when a live https Stripe checkout link exists (auto-confirm + structured pricing).
    // Show a pay button and word the footer to match; otherwise keep the "Mark will be in
    // touch" fallback. Mirrors emailSnippets.depositInstructionLine so the on-screen card
    // and the confirmation email never contradict. https-only, DOM nodes only (L-003).
    // The deposit is the action the business needs, so it comes BEFORE the calendar link
    // (S9), and the concrete fact behind "securely" sits under the button (D8), the same
    // sentence the email shows.
    const payUrl = (typeof bookData.depositPayUrl === "string" && bookData.depositPayUrl.startsWith("https://")) ? bookData.depositPayUrl : null;
    if(payUrl){
      bub.appendChild(document.createElement("br"));
      bub.appendChild(document.createElement("br"));
      const pa = document.createElement("a");
      pa.href = payUrl;
      pa.target = "_blank";
      pa.rel = "noopener";
      pa.style.cssText = "display:inline-block;background:#1a8a7a;color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:0.85rem;margin-top:6px;";
      pa.textContent = "Pay your deposit securely";
      bub.appendChild(pa);
      bub.appendChild(document.createElement("br"));
      const payNote = document.createElement("span");
      payNote.style.cssText = "font-size:0.78rem;color:#718096;";
      payNote.textContent = "Payment is handled securely by our payment provider. We never see your card details.";
      bub.appendChild(payNote);
    }
    // Calendar link: only render if it looks like a Google Calendar URL
    if(bookData.calLink && typeof bookData.calLink === "string" && bookData.calLink.startsWith("https://calendar.google.com/")){
      bub.appendChild(document.createElement("br"));
      bub.appendChild(document.createElement("br"));
      const a = document.createElement("a");
      a.href = bookData.calLink;
      a.target = "_blank";
      a.rel = "noopener";
      a.style.cssText = "display:inline-block;background:#1a8a7a;color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:0.85rem;margin-top:6px;";
      a.textContent = "Add to my calendar";
      bub.appendChild(a);
    }
    bub.appendChild(document.createElement("br"));
    bub.appendChild(document.createElement("br"));
    // The deposit on the card is the server's figure of record (copy review B-3):
    // chat.js recomputes it from quote_lines and returns it as bookData.deposit, the
    // same figure the emails and the Stripe link use. The model's own BOOKING_READY
    // figure is only the fallback for a response that carries none.
    const depositShown = (typeof bookData.deposit === "string" && bookData.deposit) ? bookData.deposit : (booking.deposit||"");
    const footer = document.createElement("span");
    footer.style.cssText = "font-size:0.82rem;color:#718096;";
    footer.textContent = payUrl
      ? "Your deposit is " + depositShown + ", which is 10% of the quote and is applied to your final bill. Please pay it now using the button above. Questions? Call 01452 452356."
      : "Mark will be in touch to arrange your deposit of " + depositShown + " (10% of the quote, applied to your final bill). Questions? Call 01452 452356.";
    bub.appendChild(footer);
    const t = document.createElement("div");
    t.className = "msg-time";
    t.textContent = "Now";
    wrap.appendChild(bub);
    wrap.appendChild(t);
    confirmDiv.appendChild(av);
    confirmDiv.appendChild(wrap);
    msgs.appendChild(confirmDiv);
    msgs.scrollTop = msgs.scrollHeight;
  }catch(e){
    appendMessage("bot","Something went wrong while I was confirming your booking, so it may not have gone through. Please call 01452 452356 or email hello@intelligentclean.co.uk and we'll book it for you.");
  }
}

async function sendMessage(){
  const input=document.getElementById("chatInput");
  const btn=document.getElementById("sendBtn");
  const text=input.value.trim();
  if(!text && !pendingImage) return;
  cancelInactivityTimer();
  document.getElementById("quickSuggestions").style.display="none";

  let userContent;
  if(pendingImage && text){
    userContent=[
      {type:"image",source:{type:"base64",media_type:pendingImage.mediaType,data:pendingImage.base64}},
      {type:"text",text:text}
    ];
    appendImageMessage("data:"+pendingImage.mediaType+";base64,"+pendingImage.base64, pendingImage.name);
    appendMessage("user",text);
  } else if(pendingImage){
    userContent=[
      {type:"image",source:{type:"base64",media_type:pendingImage.mediaType,data:pendingImage.base64}},
      {type:"text",text:"Please look at this photo of my carpet and tell me what type it is, what condition it is in, and what cleaning method you would recommend."}
    ];
    appendImageMessage("data:"+pendingImage.mediaType+";base64,"+pendingImage.base64, pendingImage.name);
  } else {
    userContent=text;
    appendMessage("user",text);
  }

  if(pendingImage){
    window.lastUploadedImage={base64:pendingImage.base64,mediaType:pendingImage.mediaType,name:pendingImage.name};
    clearImage();
  }

  conversationHistory.push({role:"user",content:userContent});
  input.value="";input.style.height="auto";btn.disabled=true;showTyping();
  try{
    const r=await fetch("/api/chat",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({messages:conversationHistory})
    });
    const d=await r.json();removeTyping();
    if(d.content&&d.content[0]){
      const reply=d.content[0].text;
      // Slice 4c: the server may attach the KB sections the answer was grounded in.
      const citations=Array.isArray(d.citations)?d.citations:null;
      // The model appends a CONVERSATION_END marker once the customer has said
      // goodbye; detect it, strip it from the visible text, and close the chat.
      const conversationEnded=/CONVERSATION_END/.test(reply);
      const booking=extractBookingReady(reply);
      const bookingAt=reply.indexOf("BOOKING_READY:");
      // A real booking attempt is the marker immediately followed by "{" (the same gate
      // extractBookingReady uses); a bare prose mention of the token is NOT an attempt and
      // must not trigger the failure fallback below.
      const bookingAttempted=/BOOKING_READY:\s*\{/.test(reply);
      if(booking){
        // Show only what the model said before the marker; the payload and any premature
        // "all booked in" prose after it are dropped, because processBooking appends the
        // real, server-confirmed outcome.
        const cleanReply=reply.slice(0,bookingAt).replace(/CONVERSATION_END/g,"").trim();
        if(cleanReply) appendMessage("bot",cleanReply,citations);
        appendMessage("bot","One moment while I check the slot is still free and book it in.");
        await processBooking(booking);
      } else if(bookingAttempted){
        // The model tried to book (marker + "{" present) but the payload would not parse.
        // Never silently drop it (the old catch did): show the pre-marker text and tell the
        // customer how to finish, so a parse failure is a visible dead-end, not a silent one.
        const cleanReply=reply.slice(0,bookingAt).replace(/CONVERSATION_END/g,"").trim();
        if(cleanReply) appendMessage("bot",cleanReply,citations);
        appendMessage("bot","Sorry, I couldn't finish confirming that automatically. Please call 01452 452356 or email hello@intelligentclean.co.uk and a person will book it in for you.");
      } else {
        const cleanReply=reply.replace(/CONVERSATION_END/g,"").trim();
        if(cleanReply) appendMessage("bot",cleanReply,citations);
      }
      conversationHistory.push({role:"assistant",content:reply});
      if(conversationEnded) endConversation();
      else resetInactivityTimer();
    } else if(d.error){
      // Surface the real error so we can diagnose 403/429/500 instead of a
      // generic "I encountered an issue" fallback.
      // The rate-limit reply (429) already tells the customer what to do (F1); wrap the rest
      // so the detail stays visible for diagnosis without landing mid-sentence (E5).
      appendMessage("bot", r.status === 429 ? String(d.error) : "Sorry, something went wrong on our side ("+d.error+"). Please try again in a moment, or call 01452 452356 or email hello@intelligentclean.co.uk.");
    } else if(r.status >= 400){
      appendMessage("bot","Sorry, the assistant isn't responding right now (error "+r.status+"). Please try again in a moment, or call 01452 452356.");
    } else {
      appendMessage("bot","Sorry, that didn't go through. Please try again, or call us on 01452 452356.");
    }
  }catch(e){
    removeTyping();
    appendMessage("bot","I can't connect at the moment. Please check your connection and try again, or call us on 01452 452356.");
  }
  // Leave the input disabled once the customer has said goodbye, otherwise the
  // closing message would be immediately followed by a live, focused box again.
  if(!conversationClosed){ btn.disabled=false; input.focus(); }
}
</script>
